diff --git a/ViVeTool/ViVeTool.sdk.csproj b/ViVeTool/ViVeTool.sdk.csproj
new file mode 100644
index 0000000..b708c78
--- /dev/null
+++ b/ViVeTool/ViVeTool.sdk.csproj
@@ -0,0 +1,32 @@
+<Project Sdk="Microsoft.NET.Sdk">
+  <PropertyGroup>
+    <TargetFramework>net481</TargetFramework>
+    <OutputType>Exe</OutputType>
+    <RootNamespace>Albacore.ViVeTool</RootNamespace>
+    <AssemblyName>ViVeTool</AssemblyName>
+    <ApplicationManifest>app.manifest</ApplicationManifest>
+    <PlatformTarget>AnyCPU</PlatformTarget>
+    <Prefer32Bit>false</Prefer32Bit>
+    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
+    <LangVersion>7.3</LangVersion>
+    <Deterministic>true</Deterministic>
+    <Nullable>disable</Nullable>
+    <ImplicitUsings>disable</ImplicitUsings>
+    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
+    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
+    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
+  </PropertyGroup>
+  <ItemGroup>
+    <Compile Include="*.cs;Properties\*.cs" />
+    <EmbeddedResource Include="Properties\Resources.resx" />
+    <EmbeddedResource Include="$(IntermediateOutputPath)FeatureDictionary.pfs.gz" LogicalName="FeatureDictionary.pfs.gz" />
+    <Reference Include="System.Net.Http" />
+    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
+    <ProjectReference Include="..\ViVe\ViVe.sdk.csproj" />
+  </ItemGroup>
+  <!-- gzip the feature dictionary so it can be embedded compactly -->
+  <Target Name="GzipDictionary" BeforeTargets="PrepareForBuild">
+    <MakeDir Directories="$(IntermediateOutputPath)" />
+    <Exec Command="powershell -NoProfile -Command &quot;$i=[IO.File]::OpenRead('$(MSBuildProjectDirectory)\..\Extra\FeatureDictionary.pfs'); $o=[IO.File]::Create('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)FeatureDictionary.pfs.gz'); $g=New-Object IO.Compression.GZipStream($o,[IO.Compression.CompressionLevel]::Optimal); $i.CopyTo($g); $g.Dispose(); $o.Dispose(); $i.Dispose()&quot;" />
+  </Target>
+</Project>
